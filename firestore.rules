rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 사용자 프로필 (users/{userId}) =====
    match /users/{userId} {
      // 읽기: 누구나 가능 (퍼블릭 프로필 페이지용)
      allow read: if true;

      // 쓰기: 로그인 + 본인 ID 일치 시만
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== 링크 서브컬렉션 (users/{userId}/links) =====
    match /users/{userId}/links/{linkId} {
      // 읽기: 누구나 가능 (퍼블릭 프로필 페이지용)
      allow read: if true;

      // 생성 및 삭제: 로그인 + 본인 ID 일치 시만
      allow create, delete: if request.auth != null && request.auth.uid == userId;

      // 수정:
      // 1) 본인: 모든 필드 수정 가능
      // 2) 누구나(비로그인 방문자 포함): clickCount(+1 증가)만 수정 가능
      allow update: if (request.auth != null && request.auth.uid == userId)
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
                      && request.resource.data.clickCount is int
                      && (
                        (
                          (!('clickCount' in resource.data) || !(resource.data.clickCount is int))
                          && request.resource.data.clickCount == 1
                        )
                        || (
                          'clickCount' in resource.data
                          && resource.data.clickCount is int
                          && request.resource.data.clickCount == resource.data.clickCount + 1
                        )
                      )
                    );
    }
  }
}
