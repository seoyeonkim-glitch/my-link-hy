rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 사용자 프로필 (users/{userId}) =====
    match /users/{userId} {
      // 읽기: 누구나 가능 (퍼블릭 프로필 페이지용)
      allow read: if true;

      // 쓰기: 로그인 + 본인 ID 일치 시만
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== 링크 서브컬렉션 (users/{userId}/links) =====
    match /users/{userId}/links/{linkId} {
      // 읽기: 누구나 가능 (퍼블릭 프로필 페이지용)
      allow read: if true;

      // 생성 및 삭제: 로그인 + 본인 ID 일치 시만
      allow create, delete: if request.auth != null && request.auth.uid == userId;

      // 수정: 본인은 모든 필드 수정 가능, 방문자(비로그인 포함)는 clickCount(+1)만 증가 가능
      allow update: if (request.auth != null && request.auth.uid == userId)
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
                      && request.resource.data.clickCount is int
                      && request.resource.data.clickCount == resource.data.get('clickCount', 0) + 1
                    );
    }
  }
}
