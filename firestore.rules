rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. 유저 문서 및 프로필 편집 경로: users/{userId}
    // (/[displayName] 공개 조회, displayName 중복 확인, 내 프로필 편집 저장)
    match /users/{userId} {
      // 읽기(get, list): 로그인하지 않은 상태에서도 누구나 읽기 가능
      allow read: if true;

      // 쓰기(create, update, delete): 로그인 상태이고 본인 UID가 일치할 때만 가능
      allow write: if request.auth != null && request.auth.uid == userId;

      // 2. 유저 링크 경로: users/{userId}/links/{linkId}
      match /links/{linkId} {
        // 읽기: 로그인하지 않은 상태에서도 누구나 읽기 가능
        allow read: if true;

        // 쓰기(추가·수정·삭제): 로그인 상태이고 본인 UID가 일치할 때만 가능
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // 3. 유저 프로필 하위 경로: users/{userId}/profile/{profileId}
      match /profile/{profileId} {
        // 읽기: 로그인하지 않은 상태에서도 누구나 읽기 가능
        allow read: if true;

        // 쓰기(프로필 편집): 로그인 상태이고 본인 UID가 일치할 때만 가능
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
